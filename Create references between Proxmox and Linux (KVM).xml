<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sa_pattern_prepost_script"&gt;&lt;sa_pattern_prepost_script action="INSERT_OR_UPDATE"&gt;&lt;active&gt;true&lt;/active&gt;&lt;execution_type&gt;1&lt;/execution_type&gt;&lt;name&gt;Create references between Proxmox and Linux (KVM)&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;pattern&gt;1d2810b14fa12200609b92918110c7a7&lt;/pattern&gt;&lt;script&gt;&lt;![CDATA[/*
 * Pre sensor: You can change payload before it will be processed by Identification Engine.
 * Input parameters: payload, patternId
 */

var rtrn = {};

// Parse the JSON string into an object
var payloadObj = JSON.parse(payload);

// Clear payload string to save memory
payload = null;

// Business logic
var replaceReferenceFieldValuesWithSysIds = function () {
    if (!payloadObj.hasOwnProperty('items')) {
        return;
    }

    var payloadItems = payloadObj.items;

    for (var i = 0; i &lt; payloadItems.length; i++) {

        if (payloadItems[i].className.includes('cmdb_ci_kvm')) {

            var linux_host = payloadItems[i].values.linux_host;
            var ip_address = payloadItems[i].values.ip_address;
            var running_process = payloadItems[i].values.running_process;

            // --- Linux server ---
            var linuxSysId = '';

            var linuxGr = new GlideRecord('cmdb_ci_linux_server');
            linuxGr.addQuery('name', linux_host);
            linuxGr.addQuery('ip_address', ip_address);            
            linuxGr.setLimit(1);
            linuxGr.query();

            if (linuxGr.next()) {
                linuxSysId = linuxGr.getUniqueValue();
            }

            payloadItems[i].values.linux_host = linuxSysId;

            // --- Running process ---
            var processSysId = '';

            var procGr = new GlideRecord('cmdb_running_process');
            procGr.addQuery('name', running_process);
            procGr.addQuery('computer', linuxSysId);
            procGr.setLimit(1);
            procGr.query();

            if (procGr.next()) {
                processSysId = procGr.getUniqueValue();
            }

            payloadItems[i].values.running_process = processSysId;
        }
    }
};

replaceReferenceFieldValuesWithSysIds();

// Return modified payload
rtrn = {
    status: {
        message: 'Create references between Proxmox and Linux Pre-Sensor finished successfuly',
        isSuccess: true
    },
    patternId: patternId,
    payload: JSON.stringify(payloadObj)
};]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sa_pattern_prepost_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;karel.benes&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-12-13 22:12:17&lt;/sys_created_on&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_id&gt;7e98be65c37d3a10982a7d0ed40131cb&lt;/sys_id&gt;&lt;sys_mod_count&gt;8&lt;/sys_mod_count&gt;&lt;sys_name&gt;Create references between Proxmox and Linux (KVM)&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;sa_pattern_prepost_script_7e98be65c37d3a10982a7d0ed40131cb&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;karel.benes&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-01-19 19:50:43&lt;/sys_updated_on&gt;&lt;use_split_payload&gt;true&lt;/use_split_payload&gt;&lt;when_to_exec&gt;1&lt;/when_to_exec&gt;&lt;/sa_pattern_prepost_script&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;7e98be65c37d3a10982a7d0ed40131cb&lt;/id&gt;&lt;sys_created_by&gt;karel.benes&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2025-12-13 22:12:16&lt;/sys_created_on&gt;&lt;sys_id&gt;a679fe65c37d3a10982a7d0ed401312e&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;karel.benes&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2025-12-13 22:12:16&lt;/sys_updated_on&gt;&lt;table&gt;sa_pattern_prepost_script&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
